Example: Nested if
import java.util.Scanner;
public class nestedif {
   public static void main(String[]args){
    Scanner sc=new Scanner(System.in);
    int len;
    System.out.println("Enter value of len:");
    len=sc.nextInt();
    for(int i=0;i<len;i++){
        if(i<len){
            if(i%2==0){
                System.out.println("It is even number");
            }
            else{
                continue;
            }
            System.out.println("Value of "+i+" is less than"+len);
        }
    }
   } 
}


